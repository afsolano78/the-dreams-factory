# Cabeceras para Cloudflare.
# Mientras la web no sea indexable (INDEXABLE en site.config.mjs), al construirla se añade aquí X-Robots-Tag para que
# no se indexe ningún archivo (páginas, imágenes, PDF…). Ver astro.config.mjs.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Recursos con nombre versionado (Astro añade un código al nombre): se pueden guardar en caché mucho tiempo.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
