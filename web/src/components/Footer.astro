---
import SocialLinks from './SocialLinks.astro';
import LogoRow from './LogoRow.astro';
import LangSwitch from './LangSwitch.astro';
import ContactIcon from './ContactIcon.astro';
import { path, type Lang, type RouteKey } from '../i18n/routes';
import { ui, press, contact } from '../i18n/ui';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  alternates?: Record<Lang, string>;
}
const { lang, routeKey, alternates } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
const [emailUser, emailDomain] = contact.email.split('@');
---

<footer class="relative isolate overflow-hidden bg-pino-900 text-white">
  <div class="container-brand pb-10 pt-10 md:pt-20">
    <!--
      Móvil: la marca en una franja arriba (logo pequeño a la izquierda, redes a la derecha) con una línea debajo; Explora y Formación en dos columnas y Contacto a todo
      el ancho. Tableta (md): la misma franja y debajo tres columnas. Ordenador (lg): cuatro columnas del ancho de su texto y el mismo hueco entre ellas, con las redes centradas bajo el nombre.
    -->
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:gap-y-12 md:grid-cols-[0.85fr_1fr_1.4fr] md:gap-x-10 lg:grid-cols-[repeat(4,auto)] lg:justify-between lg:gap-12">
      <div class="col-span-2 flex w-full flex-row items-center justify-between gap-6 border-b border-white/10 pb-6 md:col-span-3 md:w-full md:flex-row md:justify-between md:border-b md:border-white/10 md:pb-10 lg:col-span-1 lg:w-fit lg:flex-col lg:justify-start lg:border-0 lg:pb-0">
        <span class="brand-logo brand-logo-sm w-32 text-white md:w-36 lg:w-44" role="img" aria-label="The Dreams Factory · Wedding Planner"></span>
        <SocialLinks />
      </div>

      <div>
        <h2 class="eyebrow mb-4 text-eucalipto-500">{t.footer.explore}</h2>
        <ul class="flex flex-col gap-2">
          {t.footer.exploreLinks.map(([key, label]) => <li><a href={path(key, lang)} class="link-draw hover:text-eucalipto-500">{label}</a></li>)}
        </ul>
      </div>

      <div>
        <h2 class="eyebrow mb-4 text-eucalipto-500">{t.footer.education}</h2>
        <ul class="flex flex-col gap-2">
          {t.footer.educationLinks.map(([key, label]) => <li><a href={path(key, lang)} class="link-draw hover:text-eucalipto-500">{label}</a></li>)}
        </ul>
      </div>

      <div class="col-span-2 md:col-span-1">
        <h2 class="eyebrow mb-4 text-eucalipto-500">{t.footer.contact}</h2>
        <!-- Móvil: los dos teléfonos en dos columnas y el correo debajo. -->
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5 md:flex md:flex-col">
          {contact.phones.map((p) => (
            <li>
              <a href={`tel:${p.replace(/\s/g, '')}`} class="flex items-center gap-3 hover:text-eucalipto-500">
                <ContactIcon name="phone" size={16} class="shrink-0 text-eucalipto-500" /><span class="link-draw">{p}</span>
              </a>
            </li>
          ))}
          <li class="col-span-2">
            <a href={`mailto:${contact.email}`} class="flex items-start gap-3 text-[0.9375rem] hover:text-eucalipto-500">
              <ContactIcon name="mail" size={16} class="mt-1 shrink-0 text-eucalipto-500" /><span class="link-draw min-w-0 [overflow-wrap:break-word]">{emailUser}<wbr />@{emailDomain}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Móvil: el copyright en una línea y los textos legales en otra, con el idioma a la derecha. -->
    <div class="mt-16 flex items-center justify-between gap-4 border-t border-white/15 pt-6 text-[0.8125rem] text-eucalipto-500">
      <p class="flex flex-col gap-1 sm:block">
        <span>© {year} The Dreams Factory</span>
        <span><span class="hidden sm:inline">{' · '}</span>{t.footer.legalLinks.map(([key, label], i) => <>{i > 0 && ' · '}<a href={path(key, lang)} class="link-draw hover:text-white">{label}</a></>)}</span>
      </p>
      <LangSwitch lang={lang} routeKey={routeKey} alternates={alternates} up class="text-white" />
    </div>
  </div>

  <!-- «Nos encontrarás en»: barra fina más oscura al final, rótulo a la izquierda y logos pequeños en línea. -->
  <div class="bg-black/25">
    <!-- En móvil, hueco abajo para la barra fija de contacto rápido. -->
    <div class="container-brand flex flex-col items-center gap-5 pb-20 pt-6 sm:flex-row sm:justify-between md:pb-6">
      <h2 class="eyebrow text-eucalipto-500">{t.footer.findUs}</h2>
      <LogoRow items={press} lang={lang} sealSize="xs" class="footer-logos-small text-white" />
    </div>
  </div>
</footer>

<style>
  /* Logos más juntos en la barra final. */
  :global(.logo-row.footer-logos-small) { gap: 1rem 2rem; }
</style>
