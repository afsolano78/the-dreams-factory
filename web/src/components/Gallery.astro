---
/*
  Galería en mosaico (cada foto con su proporción) con visor: al pulsar una foto se abre en grande, con anterior y
  siguiente (botones, flechas del teclado o deslizando en el móvil); se cierra con ×, Escape o un clic fuera.
  Sin JavaScript, cada foto es un enlace a su versión grande. La foto grande solo se descarga al abrirla.
  Se usa en la página de cada boda y en la del curso; puede haber más de una por página.
*/
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { src: ImageMetadata; alt: string }[];
  labels: { title: string; enlarge: string; close: string; prev: string; next: string; of: string };
  class?: string;
}
const { items, labels, class: className = '' } = Astro.props;
/** Versión grande para el visor, sin ampliar nunca el original. */
const large = await Promise.all(items.map((g) => getImage({ src: g.src, width: Math.min(g.src.width, 1600), format: 'webp' })));
---

<div class={className} data-gallery-root data-of={labels.of}>
  <ul class="gallery-grid">
    {
      items.map((g, k) => (
        <li>
          <a href={large[k].src} class="group block overflow-hidden" data-gallery-item={k} data-alt={g.alt} aria-label={`${labels.enlarge}: ${g.alt}`}>
            <Picture
              src={g.src}
              alt={g.alt}
              widths={[400, 640, 960]}
              sizes="(min-width: 1024px) 30vw, 50vw"
              formats={['avif', 'webp']}
              class="w-full transition-transform duration-700 group-hover:scale-[1.03] motion-reduce:transition-none"
            />
          </a>
        </li>
      ))
    }
  </ul>

  <dialog class="gallery-viewer" aria-label={labels.title} data-viewer>
    <figure class="flex h-full flex-col items-center justify-center gap-4 px-14 py-16 md:px-24">
      <img class="viewer-img" alt="" data-viewer-img />
      <figcaption class="max-w-[40rem] text-center text-[0.875rem] text-white/80">
        <span data-viewer-caption></span>
        <span class="ml-2 text-white/50" data-viewer-count></span>
      </figcaption>
    </figure>
    <button type="button" class="viewer-btn right-4 top-4" aria-label={labels.close} data-viewer-close>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <button type="button" class="viewer-btn left-3 top-1/2 -translate-y-1/2 md:left-6" aria-label={labels.prev} data-viewer-prev>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button type="button" class="viewer-btn right-3 top-1/2 -translate-y-1/2 md:right-6" aria-label={labels.next} data-viewer-next>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery-root]').forEach((root) => {
    const viewer = root.querySelector<HTMLDialogElement>('[data-viewer]');
    const items = [...root.querySelectorAll<HTMLAnchorElement>('[data-gallery-item]')];
    if (!viewer || !items.length) return;
    const img = viewer.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const caption = viewer.querySelector<HTMLElement>('[data-viewer-caption]')!;
    const count = viewer.querySelector<HTMLElement>('[data-viewer-count]')!;
    const of = root.dataset.of ?? '/';
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (n: number) => {
      current = (n + items.length) % items.length;
      const a = items[current];
      img.src = a.href;
      img.alt = a.dataset.alt ?? '';
      caption.textContent = a.dataset.alt ?? '';
      count.textContent = `${current + 1} ${of} ${items.length}`;
      // Precarga la siguiente para que el paso sea inmediato.
      new Image().src = items[(current + 1) % items.length].href;
    };

    items.forEach((a, n) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        opener = a;
        show(n);
        viewer.showModal();
      }),
    );
    viewer.querySelector('[data-viewer-prev]')!.addEventListener('click', () => show(current - 1));
    viewer.querySelector('[data-viewer-next]')!.addEventListener('click', () => show(current + 1));
    viewer.querySelector('[data-viewer-close]')!.addEventListener('click', () => viewer.close());
    viewer.addEventListener('click', (e) => {
      if (e.target === viewer || (e.target as HTMLElement).tagName === 'FIGURE') viewer.close();
    });
    viewer.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    // Deslizar en móvil.
    let x0: number | null = null;
    viewer.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    viewer.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      x0 = null;
    });
    viewer.addEventListener('close', () => opener?.focus());
  });
</script>

<style>
  .gallery-grid { columns: 2; column-gap: 0.75rem; }
  @media (min-width: 1024px) { .gallery-grid { columns: 3; column-gap: 1rem; } }
  .gallery-grid > li { break-inside: avoid; margin-bottom: 0.75rem; }
  @media (min-width: 1024px) { .gallery-grid > li { margin-bottom: 1rem; } }
  .gallery-grid :global(picture) { display: block; }

  .gallery-viewer {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
  }
  .gallery-viewer::backdrop { background: color-mix(in srgb, var(--color-pino-900) 94%, transparent); }
  .viewer-img {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
  }
  .viewer-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    transition: background-color 0.2s ease;
  }
  .viewer-btn:hover { background: rgb(255 255 255 / 0.2); }
</style>
