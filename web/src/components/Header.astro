---
import Wordmark from './Wordmark.astro';
import Button from './Button.astro';
import LangSwitch from './LangSwitch.astro';
import SocialLinks from './SocialLinks.astro';
import ContactIcon from './ContactIcon.astro';
import { path, langs, type Lang, type RouteKey } from '../i18n/routes';
import { ui, contact } from '../i18n/ui';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  alternates?: Record<Lang, string>;
  /** Transparente sobre la foto de la portada; se vuelve sólida al hacer scroll. */
  overlay?: boolean;
}
const { lang, routeKey, alternates, overlay = false } = Astro.props;
const t = ui[lang];
// Menú del móvil: «Inicio» delante de las secciones, WhatsApp junto a Contacto e idioma abajo.
const menuItems: [RouteKey, string][] = [['home', lang === 'es' ? 'Inicio' : 'Home'], ...t.nav];
const whatsapp = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(t.quickContact.whatsappText)}`;
const [emailUser, emailDomain] = contact.email.split('@');
---

<header class="site-header" data-overlay={overlay ? 'true' : 'false'} data-scrolled="false" data-menu="closed">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-6 px-5 py-4 min-[1180px]:px-16 min-[1180px]:py-5">
    <a href={path('home', lang)} class="header-fg shrink-0" aria-label="The Dreams Factory, inicio">
      <span class="hidden sm:block"><Wordmark size="md" /></span>
      <span class="block sm:hidden"><Wordmark size="sm" /></span>
    </a>

    <nav class="hidden min-[1180px]:block" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <ul class="flex items-center gap-9">
        {
          t.nav.map(([key, label]) => (
            <li>
              <a
                href={path(key, lang)}
                class="nav-link header-fg eyebrow !tracking-[0.12em] text-[0.8125rem]"
                aria-current={key === routeKey ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-5">
      <LangSwitch lang={lang} routeKey={routeKey} alternates={alternates} class="header-fg lang-top" />
      <div class="hidden min-[1180px]:block">
        <Button href={path('contact', lang)} variant={overlay ? 'light' : 'secondary'} class="header-button">{t.contactButton}</Button>
      </div>
      <button
        type="button"
        class="menu-toggle header-fg min-[1180px]:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-open-label={t.menuOpen}
        data-close-label={t.menuClose}
        aria-label={t.menuOpen}
      >
        <svg width="26" height="18" viewBox="0 0 26 18" fill="none" aria-hidden="true">
          <path class="bar-top" d="M0 1h26" stroke="currentColor" stroke-width="1.5"></path>
          <path class="bar-mid" d="M0 9h26" stroke="currentColor" stroke-width="1.5"></path>
          <path class="bar-bot" d="M8 17h18" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu min-[1180px]:hidden" hidden>
    <nav aria-label={lang === 'es' ? 'Menú' : 'Menu'} class="flex min-h-full flex-col gap-8 px-5 pb-8 pt-5">
      <ul class="flex flex-col gap-3">
        {
          menuItems.map(([key, label], i) => (
            <li class="menu-item" style={`--i:${i}`}>
              <a href={path(key, lang)} class="menu-link display-m text-white" aria-current={key === routeKey ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="menu-item flex flex-col gap-5" style={`--i:${menuItems.length}`}>
        <div class="flex flex-wrap gap-3">
          <Button href={path('contact', lang)} variant="primary">{t.contactButton}</Button>
          <Button href={whatsapp} variant="light" target="_blank" rel="noopener">{t.quickContact.whatsapp}</Button>
        </div>
        <ul class="flex flex-col gap-2 text-[0.9375rem] text-white/80">
          <li class="flex flex-wrap gap-x-5 gap-y-2">
            {contact.phones.map((p) => (
              <a href={`tel:${p.replace(/\s/g, '')}`} class="inline-flex items-center gap-2"><ContactIcon name="phone" size={15} class="text-eucalipto-500" />{p}</a>
            ))}
          </li>
          <li>
            <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-2 [overflow-wrap:anywhere]"><ContactIcon name="mail" size={15} class="shrink-0 text-eucalipto-500" />{emailUser}<wbr />@{emailDomain}</a>
          </li>
        </ul>
      </div>

      <!-- Abajo: redes e idioma. -->
      <div class="menu-item mt-auto border-t border-white/15 pt-6" style={`--i:${menuItems.length + 1}`}>
        <div class="flex flex-wrap items-center justify-between gap-6">
          <SocialLinks />
          <p class="eyebrow flex items-center gap-3 !tracking-[0.14em] text-[0.8125rem]">
            {langs.map((l, k) => (
              <>
                {k > 0 && <span class="text-white/40" aria-hidden="true">·</span>}
                <a
                  href={alternates?.[l] ?? path(routeKey, l)}
                  hreflang={l}
                  lang={l}
                  class:list={[l === lang ? 'text-eucalipto-500' : 'text-white/70']}
                  aria-current={l === lang ? 'true' : undefined}
                >
                  {l.toUpperCase()}
                </a>
              </>
            ))}
          </p>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--color-pino-800);
    background: var(--color-porcelana-50);
    border-bottom: 1px solid var(--color-linea);
    /* Paso de transparente a sólida al hacer scroll: suave, y las letras cambian un poco después que el fondo. */
    transition:
      background-color 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.45s cubic-bezier(0.4, 0, 0.2, 1) 0.12s;
  }
  /* Sobre la foto: transparente y en blanco, hasta que se hace scroll o se abre el menú. */
  .site-header[data-overlay='true'][data-scrolled='false'][data-menu='closed'] {
    color: #fff;
    background: transparent;
    border-color: transparent;
  }
  .site-header:is([data-menu='open'], [data-menu='closing']) {
    color: #fff;
    background: var(--color-pino-800);
    border-color: transparent;
  }
  .site-header.no-transition { transition: none !important; }
  .header-fg { color: inherit; }
  .nav-link {
    position: relative;
    padding-block: 0.25rem;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  /* El botón de contacto sigue el color de la cabecera cuando deja de estar sobre la foto. */
  .site-header:not([data-scrolled='false'][data-overlay='true']) :global(.header-button) {
    border-color: var(--color-pino-800);
    color: var(--color-pino-800);
    --btn-fill: var(--color-pino-800);
  }
  .site-header:not([data-scrolled='false'][data-overlay='true']) :global(.header-button:focus-visible) {
    color: #fff;
  }
  /* Solo con ratón, igual que el relleno del botón (ver .btn en global.css). */
  @media (hover: hover) {
    .site-header:not([data-scrolled='false'][data-overlay='true']) :global(.header-button:hover) {
      color: #fff;
    }
  }
  /* Ocupa el resto de la pantalla y se desplaza por dentro si no cabe (la página queda quieta detrás). */
  .mobile-menu {
    background: var(--color-pino-800);
    height: calc(100dvh - 4.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    /* Panel lateral: entra desde la derecha (el lado del botón) y sale hacia ese mismo lado. */
    transform: translateX(100%);
    transition: transform 0.45s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .mobile-menu::-webkit-scrollbar { display: none; }
  .site-header[data-menu='open'] .mobile-menu { transform: none; }
  .site-header[data-menu='closing'] .mobile-menu { transition: transform 0.35s cubic-bezier(0.55, 0, 0.75, 0.2); }
  .site-header:is([data-menu='open'], [data-menu='closing']) :global(.lang-top) { visibility: hidden; }
  /* Página actual: en champán, con un punto delante. */
  .menu-link { position: relative; display: inline-block; transition: color 0.2s ease; }
  .menu-link[aria-current='page'] { color: var(--color-eucalipto-500); }
  .menu-link[aria-current='page']::before {
    content: '';
    position: absolute;
    left: -0.95rem;
    top: 50%;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: currentColor;
    transform: translateY(-50%);
  }
  /* Al abrir, las opciones llegan una tras otra, un poco por detrás del panel. */
  .site-header[data-menu='open'] .menu-item { animation: menu-in 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both; animation-delay: calc(100ms + var(--i) * 40ms); }
  @keyframes menu-in {
    from { opacity: 0; transform: translateX(2rem); }
    to { opacity: 1; transform: none; }
  }
  .menu-toggle svg path {
    transition: transform 0.25s ease, opacity 0.2s ease;
    transform-origin: center;
  }
  .site-header[data-menu='open'] .bar-top { transform: translateY(8px) rotate(45deg); }
  .site-header[data-menu='open'] .bar-mid { opacity: 0; }
  .site-header[data-menu='open'] .bar-bot { transform: translate(-4px, -8px) rotate(-45deg) scaleX(1.44); }
  @media (prefers-reduced-motion: reduce) {
    .site-header, .menu-toggle svg path, .nav-link::after { transition: none; }
    .site-header[data-menu='open'] .menu-item { animation: none; }
    .mobile-menu { transition: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = header?.querySelector<HTMLElement>('#mobile-menu');

  if (header) {
    const onScroll = () => {
      header.dataset.scrolled = window.scrollY > 40 ? 'true' : 'false';
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (header && toggle && menu) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // La barra cambia de color de golpe, sin la transición pensada para el scroll: al abrir, antes de que entre el
    // panel; al cerrar, cuando ya ha salido.
    const instantColor = () => {
      header.classList.add('no-transition');
      requestAnimationFrame(() => requestAnimationFrame(() => header.classList.remove('no-transition')));
    };
    let closeTimer: number | undefined;
    const finishClose = () => {
      instantColor();
      header.dataset.menu = 'closed';
      menu.hidden = true;
      document.documentElement.style.overflow = '';
      document.documentElement.classList.remove('menu-open');
    };
    const setOpen = (open: boolean) => {
      clearTimeout(closeTimer);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '');
      if (open) {
        instantColor();
        menu.hidden = false;
        void menu.offsetHeight; // pinta el panel fuera de la pantalla antes de meterlo, para que se anime
        header.dataset.menu = 'open';
        document.documentElement.style.overflow = 'hidden';
        document.documentElement.classList.add('menu-open');
      } else if (header.dataset.menu === 'open') {
        if (reduceMotion.matches) return finishClose();
        header.dataset.menu = 'closing';
        closeTimer = window.setTimeout(finishClose, 370);
      }
    };
    toggle.addEventListener('click', () => setOpen(header.dataset.menu !== 'open'));
    document.addEventListener('keydown', (e) => {
      if (header.dataset.menu !== 'open') return;
      if (e.key === 'Escape') {
        setOpen(false);
        toggle.focus();
      } else if (e.key === 'Tab') {
        // Con el menú abierto, el foco va del botón de cerrar a las opciones y vuelta.
        const items = [toggle, ...menu.querySelectorAll<HTMLElement>('a[href]')];
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
  }
</script>
