---
/*
  Presentación del logo: el nombre se dibuja trazo a trazo (como los motivos) y se rellena; luego el logo se
  desvanece y la cortina se abre como un telón, en dos mitades que se retiran hacia arriba y hacia abajo.
  Al empezar a abrirse avisa a la página (html.intro-open + evento «tdf:intro-open», ver src/scripts/intro.ts)
  para que sus efectos arranquen en ese momento y no ocurran tapados.
  La decisión de mostrarla se toma en <head> (BaseLayout) añadiendo html.intro antes de pintar.
*/
---

<div class="intro-overlay" aria-hidden="true">
  <span class="intro-half intro-top"></span>
  <span class="intro-half intro-bottom"></span>
  <svg viewBox="0 0 900 230" class="intro-logo w-[min(88vw,640px)]">
    <text class="intro-main" x="450" y="112" text-anchor="middle">THE DREAMS FACTORY</text>
    <text class="intro-script" x="450" y="186" text-anchor="middle">Wedding Planner</text>
  </svg>
</div>

<style>
  .intro-overlay { display: none; }
  :global(html.intro) .intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  :global(html.intro:not(.intro-open)) .intro-overlay { pointer-events: auto; }
  :global(html.intro) { overflow: hidden; }

  /* Las dos mitades del telón. Red de seguridad: aunque falle el script, se abren solas a los 3,6 s. */
  .intro-half {
    position: absolute;
    inset-inline: 0;
    height: 50.5%;
    background: var(--color-porcelana-50);
  }
  .intro-top { top: 0; animation: intro-up 0.9s cubic-bezier(0.7, 0, 0.2, 1) 3.6s forwards; }
  .intro-bottom { bottom: 0; animation: intro-down 0.9s cubic-bezier(0.7, 0, 0.2, 1) 3.6s forwards; }
  /* Un filo fino donde se separan, como el borde de una tela. */
  .intro-top { box-shadow: 0 1px 0 rgb(15 53 52 / 0.06); }
  .intro-logo { position: relative; animation: intro-logo-out 0.4s ease 3.3s forwards; }

  text {
    fill: transparent;
    stroke-width: 0.9;
    stroke-dasharray: 700;
    stroke-dashoffset: 700;
  }
  .intro-main {
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 28;
    font-weight: 400;
    font-size: 54px;
    letter-spacing: 0.14em;
    stroke: var(--color-pino-800);
  }
  .intro-script {
    font-family: var(--font-script);
    font-size: 64px;
    stroke: var(--color-ciruela-700);
  }

  /* Secuencia normal: empieza cuando las fuentes están listas (html.intro-go, lo pone el script de abajo). */
  :global(html.intro-go) .intro-main { animation: intro-draw 1.6s ease-in-out forwards, intro-fill-main 0.6s ease 1.3s forwards; }
  :global(html.intro-go) .intro-script { animation: intro-draw 1.4s ease-in-out 0.5s forwards, intro-fill-script 0.6s ease 1.6s forwards; }
  :global(html.intro-go) .intro-logo { animation: intro-logo-out 0.35s ease 2.2s forwards; }
  :global(html.intro-go) .intro-top { animation: intro-up 0.9s cubic-bezier(0.7, 0, 0.2, 1) 2.4s forwards; }
  :global(html.intro-go) .intro-bottom { animation: intro-down 0.9s cubic-bezier(0.7, 0, 0.2, 1) 2.4s forwards; }

  @keyframes intro-draw { to { stroke-dashoffset: 0; } }
  @keyframes intro-fill-main { to { fill: var(--color-pino-800); stroke-width: 0; } }
  @keyframes intro-fill-script { to { fill: var(--color-ciruela-700); stroke-width: 0; } }
  @keyframes intro-logo-out { to { opacity: 0; transform: scale(0.97); } }
  @keyframes intro-up { to { transform: translateY(-100%); } }
  @keyframes intro-down { to { transform: translateY(100%); } }
</style>

<script is:inline>
  (() => {
    const html = document.documentElement;
    if (!html.classList.contains('intro')) return;
    const top = document.querySelector('.intro-top');
    const bottom = document.querySelector('.intro-bottom');
    const go = () => html.classList.add('intro-go');
    const fonts = document.fonts
      ? Promise.all([document.fonts.load('54px "Bodoni Moda Variable"'), document.fonts.load('64px "Pinyon Script"')])
      : Promise.resolve();
    Promise.race([fonts, new Promise((r) => setTimeout(r, 1200))]).then(go, go);

    // El telón empieza a abrirse: la página arranca sus efectos.
    top?.addEventListener('animationstart', (e) => {
      if (e.animationName.indexOf('intro-up') === -1 || html.classList.contains('intro-open')) return;
      html.classList.add('intro-open');
      window.dispatchEvent(new Event('tdf:intro-open'));
    });
    // Telón abierto: fuera la presentación.
    bottom?.addEventListener('animationend', (e) => {
      if (e.animationName.indexOf('intro-down') === -1) return;
      html.classList.remove('intro', 'intro-go', 'intro-open');
      try { localStorage.setItem('tdf-intro-seen', '1'); } catch {}
    });
  })();
</script>
