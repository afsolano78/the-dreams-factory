---
/*
  Presentación del logo: el logo (public/brand, con las flores) aparece de arriba abajo; luego se
  desvanece y la cortina se abre como un telón, en dos mitades que se retiran hacia arriba y hacia abajo.
  Al empezar a abrirse avisa a la página (html.intro-open + evento «tdf:intro-open», ver src/scripts/intro.ts)
  para que sus efectos arranquen en ese momento y no ocurran tapados.
  La decisión de mostrarla se toma en <head> (BaseLayout) añadiendo html.intro antes de pintar.
*/
---

<div class="intro-overlay" aria-hidden="true">
  <span class="intro-half intro-top"></span>
  <span class="intro-half intro-bottom"></span>
  <span class="intro-logo brand-logo w-[min(72vw,26rem)]"></span>
</div>

<style>
  .intro-overlay { display: none; }
  :global(html.intro) .intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  :global(html.intro:not(.intro-open)) .intro-overlay { pointer-events: auto; }
  :global(html.intro) { overflow: hidden; }

  /* Las dos mitades del telón. Red de seguridad: aunque falle el script, se abren solas a los 3,6 s. */
  .intro-half {
    position: absolute;
    inset-inline: 0;
    height: 50.5%;
    background: var(--color-porcelana-50);
  }
  .intro-top { top: 0; animation: intro-up 0.9s cubic-bezier(0.7, 0, 0.2, 1) 3.6s forwards; }
  .intro-bottom { bottom: 0; animation: intro-down 0.9s cubic-bezier(0.7, 0, 0.2, 1) 3.6s forwards; }
  /* Un filo fino donde se separan, como el borde de una tela. */
  .intro-top { box-shadow: 0 1px 0 color-mix(in srgb, var(--color-pino-800) 6%, transparent); }
  .intro-logo { position: relative; animation: intro-logo-out 0.4s ease 3.3s forwards; }

  /* Oculto hasta que empieza la secuencia. */
  .intro-logo { color: var(--color-pino-800); clip-path: inset(0 0 100% 0); opacity: 0; }

  /* Secuencia normal: empieza cuando el logo ha cargado (html.intro-go, lo pone el script de abajo). */
  :global(html.intro-go) .intro-logo {
    animation: intro-reveal 1.5s cubic-bezier(0.45, 0, 0.2, 1) forwards, intro-logo-out 0.35s ease 2.3s forwards;
  }
  :global(html.intro-go) .intro-top { animation: intro-up 0.9s cubic-bezier(0.7, 0, 0.2, 1) 2.55s forwards; }
  :global(html.intro-go) .intro-bottom { animation: intro-down 0.9s cubic-bezier(0.7, 0, 0.2, 1) 2.55s forwards; }

  @keyframes intro-reveal { 0% { opacity: 0; } 15% { opacity: 1; } 100% { opacity: 1; clip-path: inset(0); } }
  @keyframes intro-logo-out { to { opacity: 0; transform: scale(0.97); } }
  @keyframes intro-up { to { transform: translateY(-100%); } }
  @keyframes intro-down { to { transform: translateY(100%); } }
</style>

<script is:inline>
  (() => {
    const html = document.documentElement;
    if (!html.classList.contains('intro')) return;
    const top = document.querySelector('.intro-top');
    const bottom = document.querySelector('.intro-bottom');
    const go = () => html.classList.add('intro-go');
    // Espera a que el logo esté descargado (como mucho 1,2 s; si no, sigue igual).
    const img = new Image();
    const loaded = new Promise((r) => { img.onload = img.onerror = r; });
    img.src = '/brand/logo-960.webp';
    Promise.race([loaded, new Promise((r) => setTimeout(r, 1200))]).then(go, go);

    // El telón empieza a abrirse: la página arranca sus efectos.
    top?.addEventListener('animationstart', (e) => {
      if (e.animationName.indexOf('intro-up') === -1 || html.classList.contains('intro-open')) return;
      html.classList.add('intro-open');
      window.dispatchEvent(new Event('tdf:intro-open'));
    });
    // Telón abierto: fuera la presentación.
    bottom?.addEventListener('animationend', (e) => {
      if (e.animationName.indexOf('intro-down') === -1) return;
      html.classList.remove('intro', 'intro-go', 'intro-open');
      try { localStorage.setItem('tdf-intro-seen', '1'); } catch {}
    });
  })();
</script>
