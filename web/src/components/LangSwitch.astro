---
/*
  Selector de idioma desplegable: muestra el idioma actual (con un globo) y, al abrirlo, la lista de idiomas con el
  actual marcado. Cada opción lleva a la misma página en ese idioma. `up`: el menú se abre hacia arriba (pie).
  El botón hereda el color del texto; el menú va siempre en blanco.
*/
import { path, langs, type Lang, type RouteKey } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props { lang: Lang; routeKey: RouteKey; up?: boolean; class?: string }
const { lang, routeKey, up = false, class: className = '' } = Astro.props;
const t = ui[lang].langSwitch;
const names: Record<Lang, string> = { es: 'Español', en: 'English' };
---

<details class={`lang-switch relative w-fit ${className}`}>
  <summary class="flex cursor-pointer list-none items-center gap-1.5 eyebrow !tracking-[0.12em] text-[0.8125rem]" aria-label={t.aria}>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
    </svg>
    {lang.toUpperCase()}
    <svg class="chevron" width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" /></svg>
  </summary>
  <ul class:list={['lang-menu absolute z-[60] min-w-[9.5rem] bg-white py-2 text-pino-800 shadow-[0_10px_30px_rgb(11_40_40/0.18)]', up ? 'bottom-full left-0 mb-3 sm:left-auto sm:right-0' : 'right-0 top-full mt-3']}>
    {langs.map((l) => (
      <li>
        <a
          href={path(routeKey, l)}
          hreflang={l}
          lang={l}
          class:list={['flex items-center justify-between gap-4 px-4 py-2 text-[0.9375rem] hover:bg-porcelana-50', { 'text-ciruela-700': l === lang }]}
          aria-current={l === lang ? 'true' : undefined}
        >
          {names[l]}
          {l === lang && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>}
        </a>
      </li>
    ))}
  </ul>
</details>

<style>
  .lang-switch summary::-webkit-details-marker { display: none; }
  .lang-switch .chevron { transition: transform 0.2s ease; }
  .lang-switch[open] .chevron { transform: rotate(180deg); }
</style>

<script>
  // Cierra el selector al pulsar fuera o con Escape.
  const switches = [...document.querySelectorAll<HTMLDetailsElement>('.lang-switch')];
  document.addEventListener('click', (e) => {
    switches.forEach((d) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    switches.forEach((d) => {
      if (!d.open) return;
      d.open = false;
      d.querySelector('summary')?.focus();
    });
  });
</script>
