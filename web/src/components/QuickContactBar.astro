---
/*
  Contacto rápido en móvil: barra fija abajo con «Llamar» y «WhatsApp». Aparece al bajar un poco (no tapa la
  portada al entrar) y solo en pantallas estrechas; en tableta y ordenador no se muestra.
*/
import ContactIcon from './ContactIcon.astro';
import { type Lang } from '../i18n/routes';
import { ui, contact } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const q = ui[lang].quickContact;
const tel = `tel:${contact.phones[0].replace(/\s/g, '')}`;
const whatsapp = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(q.whatsappText)}`;
---

<nav class="quick-contact" aria-label={q.label} data-visible="false">
  <a href={tel} class="flex flex-1 items-center justify-center gap-2.5">
    <ContactIcon name="phone" size={18} class="text-eucalipto-500" />{q.call}
  </a>
  <span class="w-px self-stretch bg-white/15" aria-hidden="true"></span>
  <a href={whatsapp} target="_blank" rel="noopener" class="flex flex-1 items-center justify-center gap-2.5">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-eucalipto-500" aria-hidden="true">
      <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z" />
      <path d="M9 8.6c.2-.6.7-.9 1.1-.6l.9 1.4c.2.4 0 .8-.3 1.1-.3.3-.3.6-.1 1a6 6 0 0 0 2 2c.4.2.7.2 1-.1.3-.3.7-.5 1.1-.3l1.4.9c.3.4 0 .9-.6 1.1-2.3.9-7.4-4.2-6.5-6.5z" />
    </svg>
    {q.whatsapp}
  </a>
</nav>

<style>
  .quick-contact {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 45;
    display: flex;
    align-items: center;
    height: calc(3.5rem + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: color-mix(in srgb, var(--color-pino-800) 96%, transparent);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translateY(100%);
    transition: transform 0.35s ease;
  }
  .quick-contact[data-visible='true'] { transform: none; }
  @media (min-width: 768px) { .quick-contact { display: none; } }
  .quick-contact a { height: 100%; }
  @media (prefers-reduced-motion: reduce) { .quick-contact { transition: none; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.quick-contact');
  if (bar) {
    const update = () => { bar.dataset.visible = String(window.scrollY > window.innerHeight * 0.6); };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
