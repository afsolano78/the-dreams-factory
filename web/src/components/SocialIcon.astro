---
/*
  Iconos de redes sociales en trazo fino (mismo estilo lineal que el icono del menú).
  Heredan el color del texto (currentColor). Son decorativos: el enlace que los contiene
  lleva el nombre accesible.
*/
import type { SocialName } from '../i18n/ui';

interface Props {
  name: SocialName;
  size?: number;
  class?: string;
}
const { name, size = 18, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {name === 'Instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'Facebook' && (
    <path d="M14.5 21v-7.25h2.6l.4-3H14.5V8.9c0-.87.25-1.46 1.5-1.46h1.6V4.76a21 21 0 0 0-2.33-.12c-2.3 0-3.87 1.4-3.87 3.98v2.13H8.8v3h2.6V21" />
  )}
  {name === 'TikTok' && (
    <path d="M14.5 3c.35 2.35 1.9 3.95 4.5 4.2v3.05a7.8 7.8 0 0 1-4.5-1.45v6.2A5.5 5.5 0 1 1 9 9.5v3.1a2.45 2.45 0 1 0 2.4 2.45V3h3.1Z" />
  )}
</svg>
