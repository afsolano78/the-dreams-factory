---
/*
  Foto que se amplía al hacer clic: la miniatura es un botón que abre un <dialog> con la foto grande sobre un fondo
  oscurecido (entra con un zoom suave). Se cierra con un clic en cualquier sitio, con Escape o con el botón ×.
  La foto grande solo se descarga al abrir por primera vez (loading="lazy" dentro del diálogo cerrado).
*/
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Texto del botón para lectores de pantalla («Ampliar la foto…»). */
  label: string;
  closeLabel: string;
  /** Clases de la miniatura (tamaño, forma, encuadre). */
  thumbClass?: string;
  thumbWidths?: number[];
  thumbSizes?: string;
}
const { src, alt, label, closeLabel, thumbClass = '', thumbWidths = [320, 480], thumbSizes = '160px' } = Astro.props;
---

<div class="zoom-photo">
  <button type="button" class="zoom-open group relative block cursor-zoom-in rounded-full" aria-label={label} aria-haspopup="dialog">
    <Picture src={src} alt={alt} widths={thumbWidths} sizes={thumbSizes} formats={['avif', 'webp']} class={`transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none ${thumbClass}`} />
    <span class="zoom-hint absolute bottom-1 right-1 grid size-8 place-items-center rounded-full bg-white/90 text-pino-800 shadow" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 20 20M10.5 8v5M8 10.5h5" /></svg>
    </span>
  </button>
  <dialog class="zoom-dialog" aria-label={alt}>
    <button type="button" class="zoom-close absolute right-4 top-4 grid size-11 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" aria-label={closeLabel}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <Picture src={src} alt={alt} widths={[800, 1200, 1600]} sizes="(min-width: 1200px) 1100px, 92vw" formats={['avif', 'webp']} loading="lazy" class="zoom-img" />
  </dialog>
</div>

<style>
  .zoom-hint { opacity: 0; transition: opacity 0.3s ease; }
  .zoom-open:is(:hover, :focus-visible) .zoom-hint { opacity: 1; }
  @media (hover: none) { .zoom-hint { opacity: 1; } }

  .zoom-dialog {
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 1.5rem;
    border: 0;
    background: transparent;
    place-items: center;
    cursor: zoom-out;
  }
  .zoom-dialog[open] { display: grid; }
  .zoom-dialog::backdrop { background: rgb(11 40 40 / 0.88); backdrop-filter: blur(4px); }
  .zoom-img { max-width: min(92vw, 1100px); max-height: 86vh; width: auto; height: auto; object-fit: contain; box-shadow: 0 20px 60px rgb(0 0 0 / 0.35); }
  .zoom-dialog[open] .zoom-img { animation: zoom-in 0.45s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .zoom-dialog[open]::backdrop { animation: zoom-fade 0.35s ease; }
  @keyframes zoom-in { from { opacity: 0; transform: scale(0.85); } }
  @keyframes zoom-fade { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .zoom-dialog[open] .zoom-img, .zoom-dialog[open]::backdrop { animation: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.zoom-photo').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('.zoom-dialog')!;
    const open = root.querySelector<HTMLButtonElement>('.zoom-open')!;
    open.addEventListener('click', () => dialog.showModal());
    // Cualquier clic dentro (foto, fondo o ×) cierra; Escape lo cierra el propio <dialog>.
    dialog.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => open.focus());
  });
</script>
