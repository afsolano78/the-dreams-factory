---
/*
  Página «Nosotras» (/nosotras, /en/about-us).
  1. Cabecera: titular y foto de las dos.
  2. Cómo empezó todo (historia y foto) y la línea de tiempo con los hitos.
  3. Las dos: una ficha para cada una (retrato, cómo es, formación).
  4. Cómo trabajamos: cuatro principios.
  5. En cifras.
  6. La prensa que ha publicado sus bodas.
  7. También enseñamos: el curso.
  8. El mismo cierre que la portada.
*/
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';
import LogoRow from '../LogoRow.astro';
import ClosingCta from '../home/ClosingCta.astro';
import { about } from '../../content/about';
import { home } from '../../content/home';
import { press } from '../../i18n/ui';
import { path, emphasize, type Lang } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = about[lang];
const pos = (focus?: string) => (focus ? `object-position:${focus}` : undefined);
---

<BaseLayout lang={lang} routeKey="about" title={c.meta.title} description={c.meta.description}>
  <!-- 1. Cabecera -->
  <section class="bg-porcelana-50 pb-16 pt-12 md:pb-24 md:pt-16">
    <div class="container-brand grid items-center gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] md:gap-14 lg:gap-20">
      <div class="flex flex-col gap-6" data-reveal>
        <p class="eyebrow eyebrow-line text-malva-500">{c.hero.eyebrow}</p>
        <h1 class="display-xl text-pino-800" set:html={emphasize(c.hero.title)} />
        <p class="lead max-w-[34rem]">{c.hero.lead}</p>
      </div>
      <div class="overflow-hidden" data-reveal style="--reveal-delay:120ms">
        <Picture
          src={c.hero.photo.src}
          alt={c.hero.photo.alt}
          widths={[560, 800, 1120, 1600]}
          sizes="(min-width: 768px) 45vw, 100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full object-cover"
          style={pos(c.hero.photo.focus)}
        />
      </div>
    </div>
  </section>

  <!-- 2. Cómo empezó todo + línea de tiempo -->
  <section class="section-y bg-white">
    <div class="container-brand flex flex-col gap-16 md:gap-20">
      <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14 lg:gap-20">
        <div class="overflow-hidden md:order-2" data-reveal>
          <Picture
            src={c.story.photo.src}
            alt={c.story.photo.alt}
            widths={[560, 800, 1024]}
            sizes="(min-width: 768px) 45vw, 100vw"
            formats={['avif', 'webp']}
            class="aspect-[1024/927] w-full object-cover"
          />
        </div>
        <div class="flex flex-col gap-6">
          <SectionHeading eyebrow={c.story.eyebrow} title={c.story.title} />
          <div class="flex flex-col gap-4 text-suave" data-reveal>
            {c.story.paragraphs.map((p, i) => <p class:list={{ 'lead drop-cap text-pino-800': i === 0 }}>{p}</p>)}
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-8" data-reveal>
        <p class="eyebrow text-malva-500">{c.timeline.eyebrow}</p>
        <ol class="timeline grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
          {
            c.timeline.items.map((t) => (
              <li class="timeline-item flex flex-col gap-2 pt-6">
                <span class:list={['timeline-year', { 'is-tag': !t.year }]}>{t.year ?? t.tag}</span>
                <p class="text-[0.9375rem] text-pino-800">{t.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 3. Las dos -->
  <section class="section-y bg-porcelana-50">
    <div class="container-brand flex flex-col gap-12">
      <SectionHeading eyebrow={c.team.eyebrow} title={c.team.title} />
      <div class="grid gap-14 md:grid-cols-2 md:gap-10 lg:gap-16">
        {
          c.team.people.map((p, i) => (
            <article class="flex flex-col gap-5" data-reveal style={`--reveal-delay:${i * 140}ms`}>
              <div class="overflow-hidden">
                <Picture
                  src={p.photo.src}
                  alt={p.photo.alt}
                  widths={[400, 600, 760]}
                  sizes="(min-width: 768px) 40vw, 100vw"
                  formats={['avif', 'webp']}
                  class="aspect-[4/5] w-full object-cover"
                  style={pos(p.photo.focus)}
                />
              </div>
              <div class="flex items-baseline gap-3">
                <h3 class="signature text-ciruela-700">{p.nickname}</h3>
                <span class="text-[0.875rem] text-suave">{p.name}</span>
              </div>
              <p class="eyebrow -mt-2 text-malva-500">{p.role}</p>
              <p class="text-pino-800">{p.text}</p>
              <p class="border-l-2 border-malva-500/50 pl-4 text-[0.875rem] text-suave">
                <span class="eyebrow mb-1 block text-malva-500">{c.team.studiesLabel}</span>
                {p.studies}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Cómo trabajamos -->
  <section class="section-y bg-white">
    <div class="container-brand flex flex-col gap-12">
      <SectionHeading eyebrow={c.values.eyebrow} title={c.values.title} />
      <ul class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {
          c.values.items.map((v, i) => (
            <li class="flex flex-col gap-3 border-t border-linea pt-6" data-reveal style={`--reveal-delay:${i * 100}ms`}>
              <h3 class="display-s text-pino-800">{v.title}</h3>
              <p class="text-[0.9375rem] text-suave">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. En cifras -->
  <section class="bg-pino-800 py-14 text-white md:py-16">
    <dl class="figures container-brand grid grid-cols-2 gap-x-6 gap-y-10 text-center lg:grid-cols-4">
      {
        c.figures.map((f) => (
          <div class="flex flex-col-reverse justify-end gap-2" data-reveal>
            <dt class="text-[0.8125rem] text-white/75">{f.label}</dt>
            <dd class="figure-value">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- 6. Prensa -->
  <section class="bg-white py-16 md:py-20">
    <div class="container-brand flex flex-col items-center gap-8 text-center" data-reveal>
      <p class="eyebrow text-malva-500">{c.press}</p>
      <LogoRow items={press.filter((l) => l.name !== 'All Lovely Party')} lang={lang} sealSize="md" class="text-pino-800" />
    </div>
  </section>

  <!-- 7. También enseñamos -->
  <section class="section-y bg-porcelana-50">
    <div class="container-brand grid items-center gap-10 md:grid-cols-2 md:gap-14 lg:gap-20">
      <div class="overflow-hidden" data-reveal>
        <Picture
          src={c.education.photo.src}
          alt={c.education.photo.alt}
          widths={[560, 800, 1120]}
          sizes="(min-width: 768px) 45vw, 100vw"
          formats={['avif', 'webp']}
          class="aspect-[4/3] w-full object-cover"
          style={pos(c.education.photo.focus)}
        />
      </div>
      <div class="flex flex-col gap-6">
        <SectionHeading eyebrow={c.education.eyebrow} title={c.education.title} />
        <p class="text-suave" data-reveal>{c.education.text}</p>
        <div class="flex flex-wrap gap-4" data-reveal>
          <Button href={path('course', lang)} variant="primary">{c.education.course}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Cierre, el mismo que en la portada -->
  <ClosingCta lang={lang} c={home[lang].closing} />
</BaseLayout>

<style>
  /* Línea de tiempo: una línea fina arriba con un punto por hito. */
  .timeline-item { position: relative; border-top: 1px solid var(--color-linea); }
  .timeline-item::before {
    content: '';
    position: absolute;
    top: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--color-ciruela-700);
  }
  .timeline-year,
  .figure-value {
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 12;
    font-weight: 500;
    line-height: 1.1;
  }
  .timeline-year { font-size: 1.75rem; color: var(--color-ciruela-700); }
  .timeline-year.is-tag { font-size: 1.25rem; font-style: italic; }
  .figure-value { font-size: clamp(2rem, 1.5rem + 2vw, 3rem); }
  /* En móvil (2 columnas), la última cifra ocupa toda la fila si queda sola. */
  @media (max-width: 1023px) { .figures > div:last-child:nth-child(odd) { grid-column: 1 / -1; } }
</style>
