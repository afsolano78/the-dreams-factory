---
/*
  Separador dibujado para el cambio entre dos secciones: una línea hecha a mano a cada lado y una ramita
  de eucalipto en el centro (o el motivo que se pase como hijo). Se coloca centrado sobre el borde superior de la sección que lo contiene
  (que debe tener position: relative). Hereda currentColor.
*/
import EucalyptusSprig from './EucalyptusSprig.astro';

interface Props { class?: string; [attr: string]: unknown }
const { class: className = '', ...rest } = Astro.props;
---

<div class={`pointer-events-none absolute left-1/2 top-0 z-[2] flex w-[min(34rem,80%)] -translate-x-1/2 -translate-y-1/2 items-center gap-3 ${className}`} aria-hidden="true" {...rest}>
  <svg data-toggle-line class="h-3 flex-1" viewBox="0 0 240 12" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
    <path d="M2 7 C 40 4, 70 9, 110 6 S 190 3, 238 6" vector-effect="non-scaling-stroke" />
  </svg>
  <div class="shrink-0"><slot><EucalyptusSprig class="w-24 sm:w-28" /></slot></div>
  <svg data-toggle-line class="h-3 flex-1 -scale-x-100" viewBox="0 0 240 12" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
    <path d="M2 7 C 40 4, 70 9, 110 6 S 190 3, 238 6" vector-effect="non-scaling-stroke" />
  </svg>
</div>
