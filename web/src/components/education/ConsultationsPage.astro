---
/*
  Página de las tutorías online (/tutorias-online, /en/online-consultations).
  1. Cabecera: titular, precio, duración, formato y botón de reserva, con foto.
  2. ¿Es para vosotros?
  3. Cómo funciona (tres pasos) y de qué podemos hablar.
  4. Qué incluye (precio y extras) junto a quiénes somos.
  5. Preguntas frecuentes y el cierre de siempre (con el formulario corto).
*/
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';
import ClosingCta from '../home/ClosingCta.astro';
import { consultations } from '../../content/education';
import { home } from '../../content/home';
import { path, emphasize, type Lang } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = consultations[lang];
const book = `${path('contact', lang)}?motivo=tutoria`;
---

<BaseLayout lang={lang} routeKey="consultations" title={c.meta.title} description={c.meta.description}>
  <!-- 1. Cabecera -->
  <section class="bg-porcelana-50 pb-16 pt-12 md:pb-24 md:pt-16">
    <div class="container-brand grid items-center gap-10 md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] md:gap-14 lg:gap-20">
      <div class="flex flex-col gap-6" data-reveal>
        <p class="eyebrow eyebrow-line text-malva-500">{c.hero.eyebrow}</p>
        <h1 class="display-xl text-pino-800" set:html={emphasize(c.hero.title)} />
        <p class="lead max-w-[34rem]">{c.hero.lead}</p>
        <ul class="flex flex-wrap gap-2">
          {c.hero.facts.map((f, i) => (
            <li class:list={['border px-4 py-2 text-[0.9375rem]', i === 0 ? 'border-ciruela-700 font-medium text-ciruela-700' : 'border-linea text-pino-800']}>{f}</li>
          ))}
        </ul>
        <div class="mt-2"><Button href={book} variant="primary">{c.hero.cta}</Button></div>
      </div>
      <div class="overflow-hidden" data-reveal style="--reveal-delay:120ms">
        <Picture
          src={c.hero.photo.src}
          alt={c.hero.photo.alt}
          widths={[560, 800, 1120]}
          sizes="(min-width: 768px) 40vw, 100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full object-cover"
          style="object-position:55% 35%"
        />
      </div>
    </div>
  </section>

  <!-- 2. ¿Es para vosotros? -->
  <section class="section-y bg-white">
    <div class="container-brand flex flex-col gap-12">
      <SectionHeading eyebrow={c.forYou.eyebrow} title={c.forYou.title} />
      <ul class="grid gap-4 sm:grid-cols-2">
        {c.forYou.items.map((item, i) => (
          <li class="border border-linea bg-porcelana-50 p-6 text-pino-800" data-reveal style={`--reveal-delay:${i * 80}ms`}>{item}</li>
        ))}
      </ul>
      <p class="font-script max-w-[40rem] text-[1.75rem] leading-snug text-ciruela-700" data-reveal>{c.forYou.closing}</p>
    </div>
  </section>

  <!-- 3. Cómo funciona y de qué hablamos -->
  <section class="section-y bg-porcelana-50">
    <div class="container-brand flex flex-col gap-16">
      <div class="flex flex-col gap-12">
        <SectionHeading eyebrow={c.how.eyebrow} title={c.how.title} />
        <ol class="grid gap-10 md:grid-cols-3 md:gap-8">
          {c.how.steps.map((s, i) => (
            <li class="flex flex-col gap-3 border-t border-linea pt-6" data-reveal style={`--reveal-delay:${i * 100}ms`}>
              <span class="step-num text-ciruela-700" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display-s text-pino-800">{s.title}</h3>
              <p class="text-[0.9375rem] text-suave">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="flex flex-col gap-5 border-t border-linea pt-12" data-reveal>
        <p class="eyebrow text-malva-500">{c.topics.eyebrow}</p>
        <h2 class="display-m text-pino-800" set:html={emphasize(c.topics.title)} />
        <p class="max-w-[36rem] text-suave">{c.topics.text}</p>
        <ul class="flex flex-wrap gap-2">
          {c.topics.items.map((t) => <li class="border border-linea bg-white px-4 py-2 text-[0.9375rem] text-pino-800">{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 4. Qué incluye y quiénes somos -->
  <section class="section-y bg-white">
    <div class="container-brand grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-14">
      <div class="flex flex-col gap-8 border border-linea bg-porcelana-50 p-6 sm:p-10" data-reveal>
        <div class="flex flex-wrap items-end justify-between gap-6">
          <SectionHeading eyebrow={c.includes.eyebrow} title={c.includes.title} size="m" />
          <p class="flex items-baseline gap-2 text-ciruela-700">
            <span class="price">{c.includes.price}</span>
            <span class="text-[0.875rem] text-suave">{c.includes.priceNote}</span>
          </p>
        </div>
        <ul class="flex flex-col gap-3">
          {c.includes.items.map((item) => (
            <li class="flex items-start gap-3 text-pino-800">
              <svg class="mt-1.5 shrink-0 text-ciruela-700" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5l5 5 10-11" /></svg>
              {item}
            </li>
          ))}
        </ul>
        <div class="border-t border-linea pt-6">
          <p class="eyebrow mb-3 text-malva-500">{c.includes.extrasTitle}</p>
          <ul class="flex flex-col gap-2.5">
            {c.includes.extras.map((e) => <li class="text-[0.9375rem] text-suave">✦ {e}</li>)}
          </ul>
        </div>
        <div><Button href={book} variant="primary">{c.includes.cta}</Button></div>
      </div>

      <div class="flex flex-col gap-6 self-center" data-reveal style="--reveal-delay:120ms">
        <div class="size-40 overflow-hidden rounded-full">
          <Picture src={c.about.photo.src} alt={c.about.photo.alt} widths={[320, 480]} sizes="160px" formats={['avif', 'webp']} class="size-full object-cover object-[50%_30%]" />
        </div>
        <h2 class="display-m text-pino-800" set:html={emphasize(c.about.title)} />
        <p class="text-suave">{c.about.text}</p>
        <a href={path('about', lang)} class="link-draw eyebrow self-start text-pino-800">{c.about.cta} →</a>
      </div>
    </div>
  </section>

  <!-- 5. Preguntas frecuentes -->
  <section class="section-y bg-porcelana-50">
    <div class="container-brand grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
      <SectionHeading eyebrow={c.faq.eyebrow} title={c.faq.title} />
      <div class="divide-y divide-linea border-y border-linea" data-reveal>
        {c.faq.items.map((item) => (
          <details class="faq group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5">
              <span class="display-s text-pino-800">{item.q}</span>
              <span class="faq-icon grid size-8 shrink-0 place-items-center rounded-full border border-linea text-ciruela-700" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 1v10M1 6h10" /></svg>
              </span>
            </summary>
            <p class="pb-6 pr-12 text-suave">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ClosingCta lang={lang} c={home[lang].closing} />
</BaseLayout>

<style>
  .step-num,
  .price {
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 12;
    font-weight: 500;
  }
  .step-num { font-style: italic; font-size: 1.25rem; }
  .price { font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem); line-height: 1; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-icon svg { transition: transform 0.3s ease; }
  .faq[open] .faq-icon svg { transform: rotate(45deg); }
</style>
