---
/*
  Página del curso «The Wedding Planner Experience» (/curso-wedding-planner, /en/wedding-planner-course).
  1. Foto a sangre con el nombre, el sello de la nueva edición, su estado y el botón «Quiero inscribirme».
  2. Para quién es y lo que lo hace distinto.
  3. Los tres días.
  4. El palacio como aula, con galería de las ediciones.
  5. Temario y ponencias.
  6. Quién enseña y la tutoría de después.
  7. Lo que dijeron las alumnas.
  8. Preguntas frecuentes y cierre con la inscripción en la nueva edición.
*/
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';
import Gallery from '../Gallery.astro';
import { course, nextEdition } from '../../content/education';
import { path, emphasize, type Lang } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = course[lang];
const notify = `${path('contact', lang)}?motivo=curso`;

// Datos de evento para Google (la próxima edición, con fechas y lugar). Sin precio: no se publica.
const hero = await getImage({ src: c.hero.photo.src, width: 1200, format: 'jpg' });
const event = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'The Wedding Planner Experience',
  description: c.meta.description,
  startDate: nextEdition.start,
  endDate: nextEdition.end,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  inLanguage: 'es',
  image: new URL(hero.src, Astro.site).href,
  url: new URL(path('course', lang), Astro.site).href,
  location: {
    '@type': 'Place',
    name: nextEdition.venue,
    address: { '@type': 'PostalAddress', addressLocality: nextEdition.city, addressRegion: nextEdition.region, addressCountry: 'ES' },
  },
  organizer: { '@type': 'Organization', name: 'The Dreams Factory', url: Astro.site?.href },
};
---

<BaseLayout lang={lang} routeKey="course" title={c.meta.title} description={c.meta.description} overlayHeader>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(event)} />
  <!-- 1. Cabecera -->
  <!-- Crece con el texto si la pantalla es baja; arriba deja sitio para la cabecera. -->
  <section class="relative isolate flex min-h-[min(88svh,920px)] items-end overflow-hidden bg-pino-900 pt-36 text-white">
    <Picture
      src={c.hero.photo.src}
      alt={c.hero.photo.alt}
      widths={[640, 960, 1440, 1600]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="course-hero-shade absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="photo-text container-brand flex w-full flex-col gap-6 pb-12 md:pb-20">
      <p class="eyebrow">{c.hero.eyebrow}</p>
      <h1 class="display-xl max-w-[16ch]" set:html={emphasize(c.hero.title)} />
      <p class="lead max-w-[36rem]">{c.hero.lead}</p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.9375rem]">
        <span class="border border-white/60 px-3 py-1.5 eyebrow !tracking-[0.14em]">{c.hero.badge}</span>
        <span class="text-white/85">{c.hero.status}</span>
      </p>
      <div class="mt-2 flex flex-wrap gap-4">
        <Button href={notify} variant="primary">{c.hero.cta}</Button>
        <Button href="#temario" variant="light">{c.hero.secondary}</Button>
      </div>
    </div>
  </section>

  <!-- 2. Para quién es -->
  <section class="section-y bg-porcelana-50">
    <div class="container-brand grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="flex flex-col gap-8">
        <SectionHeading eyebrow={c.forWhom.eyebrow} title={c.forWhom.title} />
        <ul class="flex flex-col gap-4" data-reveal>
          {c.forWhom.items.map((item) => (
            <li class="flex items-start gap-3 text-pino-800">
              <svg class="mt-1.5 shrink-0 text-ciruela-700" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5l5 5 10-11" /></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <ul class="grid gap-px self-center border border-linea bg-linea sm:grid-cols-2" data-reveal style="--reveal-delay:120ms">
        {c.forWhom.features.map((f) => (
          <li class="flex flex-col gap-2 bg-white p-6">
            <span class="display-s text-pino-800">{f.title}</span>
            <span class="text-[0.9375rem] text-suave">{f.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Los tres días -->
  <section class="section-y bg-white">
    <div class="container-brand flex flex-col gap-12">
      <SectionHeading eyebrow={c.days.eyebrow} title={c.days.title} />
      <ol class="grid gap-12 md:grid-cols-3 md:gap-8">
        {c.days.items.map((d, i) => (
          <li class="flex flex-col gap-4" data-reveal style={`--reveal-delay:${i * 120}ms`}>
            <div class="overflow-hidden">
              <Picture
                src={d.photo.src}
                alt={d.photo.alt}
                widths={[400, 640, 800]}
                sizes="(min-width: 768px) 30vw, 100vw"
                formats={['avif', 'webp']}
                class="aspect-[4/5] w-full object-cover"
              />
            </div>
            <span class="eyebrow text-malva-500">{d.label}</span>
            <h3 class="display-s -mt-2 text-pino-800">{d.title}</h3>
            <p class="text-[0.9375rem] text-suave">{d.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. El palacio como aula -->
  <section class="section-y bg-porcelana-50">
    <div class="container-brand flex flex-col gap-12">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
        <SectionHeading eyebrow={c.palace.eyebrow} title={c.palace.title} />
        <div class="flex flex-col gap-4 text-suave" data-reveal>
          {c.palace.text.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <Gallery items={c.palace.gallery} labels={c.gallery} />
    </div>
  </section>

  <!-- 5. Temario -->
  <section id="temario" class="course-anchor section-y bg-white">
    <div class="container-brand grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <div class="flex flex-col gap-8">
        <SectionHeading eyebrow={c.syllabus.eyebrow} title={c.syllabus.title} />
        <div class="border-l-2 border-malva-500/50 pl-5" data-reveal>
          <p class="display-s mb-2 text-pino-800">{c.syllabus.talks.title}</p>
          <p class="text-[0.9375rem] text-suave">{c.syllabus.talks.text}</p>
        </div>
      </div>
      <ol class="flex flex-col" data-reveal>
        {c.syllabus.items.map((item, i) => (
          <li class="flex items-baseline gap-6 border-b border-linea py-4 first:border-t">
            <span class="course-num text-ciruela-700" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-[1.0625rem] text-pino-800">{item}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. Quién enseña y después del curso -->
  <section class="section-y bg-porcelana-50">
    <div class="container-brand grid items-center gap-10 md:grid-cols-2 md:gap-14 lg:gap-20">
      <div class="overflow-hidden" data-reveal>
        <Picture
          src={c.teachers.photo.src}
          alt={c.teachers.photo.alt}
          widths={[560, 800, 1120]}
          sizes="(min-width: 768px) 45vw, 100vw"
          formats={['avif', 'webp']}
          class="aspect-[4/3] w-full object-cover"
        />
      </div>
      <div class="flex flex-col gap-6">
        <SectionHeading eyebrow={c.teachers.eyebrow} title={c.teachers.title} />
        <p class="text-suave" data-reveal>{c.teachers.text}</p>
        <a href={path('about', lang)} class="link-draw eyebrow self-start text-pino-800" data-reveal>{c.teachers.cta} →</a>
        <div class="mt-4 border border-linea bg-white p-6" data-reveal>
          <p class="font-script text-[1.75rem] leading-tight text-ciruela-700">{c.after.title}</p>
          <p class="mt-3 text-[0.9375rem] text-suave">{c.after.text}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Las alumnas -->
  <section class="section-y bg-white">
    <div class="container-brand flex flex-col gap-12">
      <SectionHeading eyebrow={c.voices.eyebrow} title={c.voices.title} />
      <ul class="grid gap-10 md:grid-cols-3 md:gap-8">
        {c.voices.items.map((v, i) => (
          <li data-reveal style={`--reveal-delay:${i * 120}ms`}>
            <figure class="flex h-full flex-col gap-5 border-l-2 border-malva-500/50 pl-5">
              <blockquote class="course-quote text-pino-800">{lang === 'es' ? `«${v.quote}»` : `“${v.quote}”`}</blockquote>
              <figcaption class="eyebrow mt-auto text-malva-500">{v.name}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. Preguntas frecuentes -->
  <section class="section-y bg-porcelana-50">
    <div class="container-brand grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
      <SectionHeading eyebrow={c.faq.eyebrow} title={c.faq.title} />
      <div class="divide-y divide-linea border-y border-linea" data-reveal>
        {c.faq.items.map((item) => (
          <details class="faq group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5">
              <span class="display-s text-pino-800">{item.q}</span>
              <span class="faq-icon grid size-8 shrink-0 place-items-center rounded-full border border-linea text-ciruela-700" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 1v10M1 6h10" /></svg>
              </span>
            </summary>
            <p class="pb-6 pr-12 text-suave">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. Cierre: inscripción en la nueva edición -->
  <section class="bg-pino-800 py-20 text-white md:py-24">
    <div class="container-brand flex flex-col items-center gap-6 text-center" data-reveal>
      <h2 class="display-l max-w-[20ch]" set:html={emphasize(c.closing.title)} />
      <p class="lead max-w-[32rem] text-white/85">{c.closing.text}</p>
      <Button href={notify} variant="light">{c.closing.cta}</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .course-hero-shade {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-pino-900) 50%, transparent) 0%,
      color-mix(in srgb, var(--color-pino-900) 15%, transparent) 30%,
      color-mix(in srgb, var(--color-pino-900) 45%, transparent) 60%,
      color-mix(in srgb, var(--color-pino-900) 88%, transparent) 100%
    );
  }
  .course-anchor { scroll-margin-top: 5rem; }
  .course-num {
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 12;
    font-style: italic;
    font-weight: 500;
    font-size: 1.375rem;
    min-width: 2rem;
  }
  .course-quote {
    font-family: var(--font-display);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 12;
    font-style: italic;
    font-weight: 500;
    font-size: 1.25rem;
    line-height: 1.45;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-icon svg { transition: transform 0.3s ease; }
  .faq[open] .faq-icon svg { transform: rotate(45deg); }
</style>
