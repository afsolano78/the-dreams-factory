---
/*
  Formación («Aprende con nosotras»): el curso (para futuras wedding planners) y las tutorías (para parejas).
  PROTOTIPO: cuatro maquetaciones para comparar desde la tarjeta «Prototipo · Opciones» (desplegable «formacion»;
  por defecto, «lista»):
  - paneles: dos fotos a sangre con el texto encima (la versión original).
  - zigzag: foto a un lado y texto al otro, alternando lados, como un reportaje de revista.
  - tarjetas: dos tarjetas blancas «de papel» con marco fino interior, foto arriba y texto debajo.
  - lista: una foto grande del curso y, al lado, las dos propuestas como lista separada por líneas finas.
  Al elegir, dejar solo la variante elegida y quitar el resto (y su regla en global.css).
*/
import { Picture } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';
import WeddingNotebook from '../deco/WeddingNotebook.astro';
import WatercolorBlob from '../deco/WatercolorBlob.astro';
import { path, type Lang } from '../../i18n/routes';
import type { HomeContent } from '../../content/home';

interface Props { lang: Lang; c: HomeContent['education'] }
const { lang, c } = Astro.props;
const { course, consultations } = c;
const panels = [
  { item: course, badge: course.badge },
  { item: consultations, badge: null },
];
---

<section class="section-y relative isolate bg-porcelana-50">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <WeddingNotebook data-toggle="libreta" class="absolute right-3 top-8 w-[110px] rotate-6 text-eucalipto-500 opacity-60 md:right-[6%] md:top-12 md:w-[160px]" />
    <WatercolorBlob data-toggle="acuarela-formacion" seed={19} class="absolute -left-24 -top-10 w-[380px] text-[#6f9486] opacity-30 md:w-[480px]" />
  </div>
  <div class="container-brand flex flex-col gap-14">
    <SectionHeading eyebrow={c.eyebrow} title={c.title} />

    <!-- Variante «paneles» (original): fotos a sangre con el texto encima. -->
    <ul data-formacion="paneles" class="grid gap-6 md:grid-cols-2">
      {panels.map(({ item, badge }, i) => (
        <li data-reveal style={`--reveal-delay:${i * 140}ms`}>
          <a href={path(item.cta.to, lang)} class="panel group relative isolate flex min-h-[36rem] flex-col justify-end overflow-hidden text-white md:aspect-[5/6] md:min-h-0">
            <Picture
              src={item.photo.src}
              alt={item.photo.alt}
              widths={[480, 720, 960]}
              sizes="(min-width: 768px) 45vw, 100vw"
              formats={['avif', 'webp']}
              class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] motion-reduce:transition-none"
              style={item.focus ? `object-position:${item.focus}` : undefined}
              data-parallax="6"
            />
            <span class="panel-shade absolute inset-0 -z-10" aria-hidden="true"></span>
            {badge && <span class="eyebrow absolute left-8 top-8 bg-ciruela-700 px-4 py-2.5 lg:left-10 lg:top-10">{badge}</span>}
            <div class="panel-body">
              <p class="eyebrow text-eucalipto-100">{item.audience}</p>
              <h3 class="display-m mt-3">{item.title}</h3>
              <p class="mt-3 max-w-[28rem] text-white/90">{item.text}</p>
              <p class="eyebrow mt-5 text-white/85">{item.meta}</p>
              <span class="eyebrow mt-6 inline-flex items-center gap-2 !tracking-[0.12em] text-[0.8125rem]">
                {item.cta.label}
                <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <!-- Variante «zigzag»: foto y texto separados, alternando lados. -->
    <div data-formacion="zigzag" class="flex flex-col gap-16 md:gap-24">
      {panels.map(({ item, badge }, i) => (
        <article class="grid items-center gap-8 md:grid-cols-2 md:gap-14 lg:gap-20" data-reveal>
          <a href={path(item.cta.to, lang)} class:list={['group relative block overflow-hidden', { 'md:order-2': i === 1 }]} tabindex="-1" aria-hidden="true">
            <Picture
              src={item.photo.src}
              alt=""
              widths={[480, 720, 960]}
              sizes="(min-width: 768px) 45vw, 100vw"
              formats={['avif', 'webp']}
              class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03] motion-reduce:transition-none"
              style={item.focus ? `object-position:${item.focus}` : undefined}
            />
            {badge && <span class="eyebrow absolute left-5 top-5 bg-ciruela-700 px-4 py-2.5 text-white">{badge}</span>}
          </a>
          <div class="flex flex-col gap-4">
            <p class="eyebrow text-malva-500">{item.audience}</p>
            <h3 class="display-m text-pino-800">{item.title}</h3>
            <p class="max-w-[30rem] text-suave">{item.text}</p>
            <p class="eyebrow text-pino-800/70">{item.meta}</p>
            <a href={path(item.cta.to, lang)} class="link-draw eyebrow mt-2 self-start !tracking-[0.12em] text-[0.8125rem] text-pino-800">{item.cta.label} →</a>
          </div>
        </article>
      ))}
    </div>

    <!-- Variante «tarjetas»: tarjetas blancas de papel con marco fino interior. -->
    <ul data-formacion="tarjetas" class="grid gap-8 md:grid-cols-2">
      {panels.map(({ item, badge }, i) => (
        <li data-reveal style={`--reveal-delay:${i * 140}ms`}>
          <article class="paper-card flex h-full flex-col bg-white p-3 shadow-[0_18px_40px_-24px_rgb(11_40_40/0.35)]">
            <div class="relative overflow-hidden">
              <Picture
                src={item.photo.src}
                alt={item.photo.alt}
                widths={[480, 720, 960]}
                sizes="(min-width: 768px) 45vw, 100vw"
                formats={['avif', 'webp']}
                class="aspect-[3/2] w-full object-cover"
                style={item.focus ? `object-position:${item.focus}` : undefined}
              />
            </div>
            <div class="m-3 flex flex-1 flex-col items-center gap-4 border border-linea px-6 py-9 text-center md:px-10">
              <p class="eyebrow text-malva-500">{item.audience}</p>
              <h3 class="display-m text-pino-800">{item.title}</h3>
              {badge && <p class="font-script text-[1.75rem] leading-none text-ciruela-700">{badge}</p>}
              <p class="max-w-[28rem] text-suave">{item.text}</p>
              <p class="eyebrow text-pino-800/70">{item.meta}</p>
              <div class="mt-auto pt-3"><Button href={path(item.cta.to, lang)} variant="secondary">{item.cta.label}</Button></div>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <!-- Variante «lista»: foto grande del curso y las dos propuestas en lista. -->
    <div data-formacion="lista" class="grid items-stretch gap-10 md:grid-cols-[1.05fr_1fr] md:gap-14 lg:gap-20" data-reveal>
      <div class="relative min-h-[20rem] overflow-hidden">
        <Picture
          src={course.photo.src}
          alt={course.photo.alt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 50vw, 100vw"
          formats={['avif', 'webp']}
          class="absolute inset-0 h-full w-full object-cover"
          style={course.focus ? `object-position:${course.focus}` : undefined}
        />
      </div>
      <!--
        PROTOTIPO: cuatro estilos de enlace (desplegable «enlace-formacion»): texto (actual) · boton · circulo · fila
        (toda la fila es el enlace, con una flecha grande a la derecha).
      -->
      <ul class="flex flex-col divide-y divide-linea border-y border-linea">
        {panels.map(({ item }) => (
          <li class="edu-row relative flex flex-col gap-3 py-9">
            <p class="eyebrow text-malva-500">{item.audience}</p>
            <h3 class="display-m pr-14 text-pino-800">{item.title}</h3>
            <p class="max-w-[30rem] text-suave">{item.text}</p>
            <p class="eyebrow text-pino-800/70">{item.meta}</p>
            <a data-edu-link="texto" href={path(item.cta.to, lang)} class="link-draw eyebrow mt-1 self-start !tracking-[0.12em] text-[0.8125rem] text-pino-800">{item.cta.label} →</a>
            <div data-edu-link="boton" class="mt-2"><Button href={path(item.cta.to, lang)} variant="secondary">{item.cta.label}</Button></div>
            <a data-edu-link="circulo" href={path(item.cta.to, lang)} class="cta-circle group eyebrow mt-2 inline-flex items-center gap-3 self-start !tracking-[0.12em] text-[0.8125rem] text-pino-800">
              {item.cta.label}
              <span class="cta-circle-icon grid size-10 place-items-center rounded-full border border-ciruela-700 text-ciruela-700" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </a>
            <a data-edu-link="fila" href={path(item.cta.to, lang)} class="edu-row-link absolute inset-0 z-[1]" aria-label={`${item.title}: ${item.cta.label}`}>
              <span class="edu-row-arrow absolute right-0 top-[4.9rem] text-ciruela-700" aria-hidden="true">
                <svg width="44" height="20" viewBox="0 0 44 20" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M1 10h41M33 2l9 8-9 8" /></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .panel { --pad: 2rem; }
  @media (min-width: 1024px) { .panel { --pad: 2.5rem; } }
  .panel-body { padding: var(--pad); }

  /* Oscurece a fondo la mitad inferior, donde va el texto, y deja la parte de arriba de la foto casi intacta. */
  .panel-shade {
    background: linear-gradient(
      180deg,
      rgb(11 40 40 / 0.1) 0%,
      rgb(11 40 40 / 0.1) 22%,
      rgb(11 40 40 / 0.62) 52%,
      rgb(11 40 40 / 0.93) 100%
    );
  }
  .panel-body { text-shadow: 0 1px 14px rgb(11 40 40 / 0.45); }

  /* Enlace «círculo»: el círculo se rellena y la flecha avanza al pasar el ratón. */
  .cta-circle-icon { transition: background-color 0.3s ease, color 0.3s ease; }
  .cta-circle-icon svg { transition: transform 0.3s ease; }
  .cta-circle:is(:hover, :focus-visible) .cta-circle-icon { background: var(--color-ciruela-700); color: #fff; }
  .cta-circle:is(:hover, :focus-visible) .cta-circle-icon svg { transform: translateX(2px); }

  /* Enlace «fila»: toda la fila es clicable; al pasar el ratón se tiñe de rosa y la flecha avanza. */
  .edu-row { transition: background-color 0.35s ease; }
  .edu-row:has(.edu-row-link:is(:hover, :focus-visible)) { background: rgb(243 230 227 / 0.55); }
  .edu-row-arrow { transition: transform 0.35s ease; }
  .edu-row-link:is(:hover, :focus-visible) .edu-row-arrow { transform: translateX(6px); }

</style>
