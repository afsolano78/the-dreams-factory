---
/*
  Franja de Instagram antes del pie: rótulo con el usuario y seis fotos cuadradas a sangre.
  Las fotos son las últimas publicaciones de la cuenta, que da el Worker en /api/instagram (worker/instagram.ts):
  la página se genera con seis fotos de bodas del propio sitio y, al acercarse a la franja, las cambia por las
  publicaciones (cada una enlaza a su post). Si Instagram no está configurado o falla, se quedan las de siempre.
*/
import { Picture } from 'astro:assets';
import SocialIcon from '../SocialIcon.astro';
import { type Lang } from '../../i18n/routes';
import { ui, contact } from '../../i18n/ui';
import p1 from '../../assets/photos/opiniones/marta-omar.jpg';
import p2 from '../../assets/photos/blog-encuentro-dreams.jpg';
import p3 from '../../assets/photos/opiniones/sonia-alberto.jpg';
import p4 from '../../assets/photos/opiniones/maria-gaspar.jpg';
import p5 from '../../assets/photos/servicio-diseno-decoracion.jpg';
import p6 from '../../assets/photos/opiniones/aida-adrian.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].instagram;
const ig = contact.social.find((s) => s.name === 'Instagram')!;
const posts = [p1, p2, p3, p4, p5, p6];
---

<section class="bg-porcelana-50" aria-labelledby="instagram-title">
  <div class="container-brand flex flex-col items-center gap-3 pb-8 pt-4 text-center sm:flex-row sm:justify-between sm:text-left" data-reveal>
    <h2 id="instagram-title" class="eyebrow text-malva-500">{t.title}</h2>
    <a href={ig.url} target="_blank" rel="noopener" class="group flex items-center gap-2.5 text-pino-800">
      <SocialIcon name="Instagram" size={20} class="text-malva-500" />
      <span class="display-s link-draw">{ig.handle}</span>
    </a>
  </div>
  <ul class="grid grid-cols-3 md:grid-cols-6" data-ig-list data-label={t.post}>
    {posts.map((src, i) => (
      <li>
        <a href={ig.url} target="_blank" rel="noopener" class="ig-post group relative block aspect-square overflow-hidden" aria-label={`${t.post} ${i + 1}`}>
          <Picture
            src={src}
            alt=""
            widths={[240, 360, 480]}
            sizes="(min-width: 768px) 17vw, 34vw"
            formats={['avif', 'webp']}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.06] motion-reduce:transition-none"
          />
          <span class="ig-hover absolute inset-0 grid place-items-center bg-pino-900/45 text-white" aria-hidden="true">
            <SocialIcon name="Instagram" size={26} />
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<script>
  // Publicaciones reales: se piden al acercarse a la franja y se cambian todas a la vez cuando sus fotos han cargado.
  type Post = { url: string; img: string; alt: string };
  const list = document.querySelector<HTMLElement>('[data-ig-list]');
  const links = list ? [...list.querySelectorAll<HTMLAnchorElement>('.ig-post')] : [];

  const load = (src: string) =>
    new Promise<HTMLImageElement>((resolve, reject) => {
      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = reject;
      img.src = src;
    });

  async function swap() {
    try {
      const res = await fetch('/api/instagram', { headers: { Accept: 'application/json' } });
      if (!res.ok) return;
      const { posts } = (await res.json()) as { posts: Post[] };
      if (!posts || posts.length < links.length) return;
      const imgs = await Promise.all(posts.slice(0, links.length).map((p) => load(p.img)));
      links.forEach((a, i) => {
        const p = posts[i];
        const old = a.querySelector('picture') ?? a.querySelector('img');
        const img = imgs[i];
        img.className = a.querySelector('img')?.className ?? '';
        img.alt = p.alt;
        img.decoding = 'async';
        old?.replaceWith(img);
        a.href = p.url;
        a.setAttribute('aria-label', `${list!.dataset.label} ${i + 1}${p.alt ? `: ${p.alt}` : ''}`);
      });
    } catch {
      // Sin publicaciones: se quedan las fotos de siempre.
    }
  }

  if (list && links.length) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        swap();
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(list);
  }
</script>

<style>
  .ig-hover { opacity: 0; transition: opacity 0.35s ease; }
  .ig-post:is(:hover, :focus-visible) .ig-hover { opacity: 1; }
</style>
