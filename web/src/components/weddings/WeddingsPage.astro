---
/*
  Listado de bodas (/bodas, /en/weddings).
  1. Introducción con filtros por tipo de lugar (palacios y castillos · campo y montaña).
  2. Las bodas en mosaico: columnas con fotos de proporciones distintas y el pie debajo (iniciales, lugar, servicio
     y fotógrafo). Las que tienen página enlazan a ella; el resto, de momento, avisan de que su galería llegará pronto.
     El mosaico (columnas CSS) se recoloca solo al filtrar, sin huecos.
  3. «Publicadas en»: los reportajes en prensa, con enlace.
  4. Editoriales: sesiones creativas, aparte de las bodas reales.
  5. El mismo cierre que la portada.
*/
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../SectionHeading.astro';
import LogoRow from '../LogoRow.astro';
import ClosingCta from '../home/ClosingCta.astro';
import { weddings, editorials, weddingsPage, weddingHref } from '../../content/weddings';
import { home } from '../../content/home';
import { press } from '../../i18n/ui';
import { emphasize, type Lang } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = weddingsPage[lang];
const filters = [
  { value: 'todas', label: c.filters.all },
  { value: 'palacio', label: c.filters.palacio },
  { value: 'campo', label: c.filters.campo },
] as const;
const pressLinks = press.filter((l) => l.href);
---

<BaseLayout lang={lang} routeKey="weddings" title={c.meta.title} description={c.meta.description}>
  <!-- 1. Introducción y filtros -->
  <section class="bg-porcelana-50 pb-10 pt-14 md:pb-14 md:pt-20">
    <div class="container-brand flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <div class="flex max-w-[44rem] flex-col gap-6" data-reveal>
        <p class="eyebrow eyebrow-line text-malva-500">{c.eyebrow}</p>
        <h1 class="display-xl text-pino-800" set:html={emphasize(c.title)} />
        <p class="lead max-w-[36rem]">{c.lead}</p>
      </div>
      <div class="flex flex-wrap gap-2 md:shrink-0 md:flex-nowrap md:justify-end" role="group" aria-label={c.filters.label} data-wed-filters data-reveal style="--reveal-delay:120ms">
        {
          filters.map((f, i) => (
            <button type="button" class="wed-chip" data-filter={f.value} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 2. Las bodas -->
  <section class="bg-porcelana-50 pb-20 md:pb-28">
    <div class="container-brand">
      <ul class="wed-masonry" data-wed-list>
        {
          weddings.map((w) => {
            const body = (
              <>
                <div class="wed-photo overflow-hidden">
                  <Picture
                    src={w.cover.src}
                    alt={w.cover.alt[lang]}
                    widths={[480, 720, 960]}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
                    formats={['avif', 'webp']}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03] motion-reduce:transition-none"
                    style={w.cover.focus ? `object-position:${w.cover.focus}` : undefined}
                  />
                </div>
                <div class="flex flex-col gap-1.5 pt-4">
                  <span class="eyebrow text-malva-500">{w.place}</span>
                  <span class="flex items-baseline justify-between gap-4">
                    <span class="display-m text-pino-800 group-hover:text-ciruela-700">{w.couple}</span>
                    {w.page ? (
                      <span class="eyebrow shrink-0 !tracking-[0.14em] text-[0.6875rem] text-pino-800">{c.viewLabel} →</span>
                    ) : (
                      <span class="shrink-0 text-[0.75rem] italic text-suave">{c.soon}</span>
                    )}
                  </span>
                  <span class="text-[0.8125rem] text-suave">
                    {w.service && <span class="wed-tag">{c.services[w.service]}</span>}
                    {c.photoBy}: {w.photographer}
                  </span>
                </div>
              </>
            );
            return (
              <li data-venue={w.venue} data-reveal>
                {w.page ? (
                  <a href={weddingHref(w, lang)} class="group block">{body}</a>
                ) : (
                  <div class="group block">{body}</div>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- 3. Publicadas en -->
  <section class="border-y border-linea bg-white py-14 md:py-16">
    <div class="container-brand flex flex-col items-center gap-8 text-center">
      <p class="eyebrow text-malva-500">{c.press.eyebrow}</p>
      <LogoRow items={pressLinks} lang={lang} sealSize="md" class="text-pino-800" />
    </div>
  </section>

  <!-- 4. Editoriales -->
  <section class="section-y bg-porcelana-50">
    <div class="container-brand flex flex-col gap-12">
      <div class="flex flex-col gap-5">
        <SectionHeading eyebrow={c.editorials.eyebrow} title={c.editorials.title} />
        <p class="max-w-[38rem] text-suave" data-reveal>{c.editorials.lead}</p>
      </div>
      <ul class="grid gap-10 md:grid-cols-2 md:gap-8">
        {
          editorials.map((e, i) => (
            <li class="flex flex-col gap-4" data-reveal style={`--reveal-delay:${i * 120}ms`}>
              <div class="overflow-hidden">
                <Picture
                  src={e.cover.src}
                  alt={e.cover.alt[lang]}
                  widths={[560, 800, 1120]}
                  sizes="(min-width: 768px) 45vw, 100vw"
                  formats={['avif', 'webp']}
                  class="aspect-[4/3] w-full object-cover"
                  style={e.cover.focus ? `object-position:${e.cover.focus}` : undefined}
                />
              </div>
              <h3 class="display-s text-pino-800">{e.title}</h3>
              <p class="-mt-2 text-[0.9375rem] text-suave">{e.text[lang]}</p>
              {e.published && <p class="-mt-1 text-[0.875rem] italic text-ciruela-700">{e.published[lang]}</p>}
              <p class="-mt-2 text-[0.8125rem] text-suave">
                {[
                  e.date?.[lang],
                  e.photographer && `${c.photoBy}: ${e.photographer}`,
                  ...(e.credits ?? []).map((cr) => `${cr.role[lang]}: ${cr.name}`),
                ].filter(Boolean).join(' · ')}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Cierre, el mismo que en la portada -->
  <ClosingCta lang={lang} c={home[lang].closing} />
</BaseLayout>

<script>
  // Filtros por tipo de lugar: ocultan las bodas que no coinciden (el mosaico se recoloca solo).
  document.querySelectorAll<HTMLElement>('[data-wed-filters]').forEach((group) => {
    const list = document.querySelector<HTMLElement>('[data-wed-list]');
    if (!list) return;
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filter;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        list.querySelectorAll<HTMLElement>('[data-venue]').forEach((li) => {
          li.hidden = f !== 'todas' && li.dataset.venue !== f;
          // Las que aparecen al filtrar ya están en pantalla: sin esperar a la animación de entrada.
          li.classList.add('is-revealed');
        });
      }),
    );
  });
</script>

<style>
  .wed-chip {
    white-space: nowrap;
    border: 1px solid var(--color-linea);
    padding: 0.6rem 1.1rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-pino-800);
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .wed-chip:hover { border-color: var(--color-pino-800); }
  .wed-chip[aria-pressed='true'] {
    background: var(--color-pino-800);
    border-color: var(--color-pino-800);
    color: #fff;
  }

  /* Mosaico: columnas con fotos de proporciones distintas (el patrón cuenta solo las bodas visibles). */
  .wed-masonry { columns: 1; column-gap: 1.75rem; }
  @media (min-width: 640px) { .wed-masonry { columns: 2; } }
  @media (min-width: 1024px) { .wed-masonry { columns: 3; column-gap: 2rem; } }
  .wed-masonry > li { break-inside: avoid; margin-bottom: 2.75rem; }
  .wed-photo { aspect-ratio: 4 / 5; }
  .wed-masonry > li:nth-child(5n + 2 of :not([hidden])) .wed-photo { aspect-ratio: 1 / 1; }
  .wed-masonry > li:nth-child(5n + 3 of :not([hidden])) .wed-photo { aspect-ratio: 3 / 4; }
  .wed-masonry > li:nth-child(5n + 4 of :not([hidden])) .wed-photo { aspect-ratio: 4 / 3; }
  .wed-masonry > li:nth-child(5n + 5 of :not([hidden])) .wed-photo { aspect-ratio: 2 / 3; }
  .wed-photo :global(picture) { display: block; height: 100%; }

  .wed-tag {
    display: inline-block;
    margin-right: 0.6rem;
    padding: 0.15rem 0.5rem;
    background: var(--color-rosa-100);
    color: var(--color-ciruela-800);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }
</style>
