---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/jost';
import '@fontsource/pinyon-script';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IntroLogo from '../components/IntroLogo.astro';
import QuickContactBar from '../components/QuickContactBar.astro';
import { routes, langs, type Lang, type RouteKey } from '../i18n/routes';
import { ui } from '../i18n/ui';
import { SITE, INDEXABLE } from '../../site.config.mjs';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { jsonLdText } from '../lib/seo';

interface Props {
  lang: Lang;
  /** Sección a la que pertenece la página (menú y, si no hay `alternates`, dirección en cada idioma). */
  routeKey: RouteKey;
  /** Dirección de esta página en cada idioma, para páginas fuera del mapa de rutas (p. ej. cada boda). */
  alternates?: Record<Lang, string>;
  title: string;
  description?: string;
  /** Cabecera transparente sobre una foto a sangre (portada). */
  overlayHeader?: boolean;
  /** Página de error: sin canónica ni alternativas de idioma, y nunca indexable. */
  notFound?: boolean;
  /** Foto al compartir la página en redes (se recorta a 1200 × 630); sin ella, la imagen general de la marca. */
  image?: ImageMetadata;
  /** «article» en las entradas del blog. */
  type?: 'website' | 'article';
  /** Datos estructurados (schema.org) de la página, ver src/lib/seo.ts. */
  jsonLd?: object[];
}
const { lang, routeKey, alternates, title, description, overlayHeader = false, notFound = false, image, type = 'website', jsonLd = [] } = Astro.props;
const paths = alternates ?? routes[routeKey];
const site = Astro.site ?? new URL(SITE);
const canonical = new URL(paths[lang], site);
const ogImage = image
  ? new URL((await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })).src, site)
  : new URL('/og-image.jpg', site);
const otherLang = langs.find((l) => l !== lang)!;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Desplazamiento suave a partir de la primera interacción (ver html.smooth-scroll en global.css).
      ['pointerdown', 'keydown'].forEach((type) =>
        addEventListener(type, () => document.documentElement.classList.add('smooth-scroll'), { once: true, passive: true }),
      );
      // Presentación del logo (ver IntroLogo.astro): solo en la portada (/ y /en/) y solo la primera vez que se entra en
      // la web (al terminar guarda «tdf-intro-seen»). Con ?intro en la dirección se vuelve a ver, para revisarla.
      try {
        const home = ['/', '/en', '/en/'].includes(location.pathname);
        const seen = (() => { try { return !!localStorage.getItem('tdf-intro-seen'); } catch { return false; } })();
        const force = new URLSearchParams(location.search).has('intro');
        if ((force || (home && !seen)) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('intro');
        }
      } catch {}
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!notFound && <link rel="canonical" href={canonical} />}
    {!notFound && langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(paths[l], site)} />)}
    {!notFound && <link rel="alternate" hreflang="x-default" href={new URL(paths.es, site)} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:locale:alternate" content={otherLang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="The Dreams Factory" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={jsonLdText(data)} />)}
    <!-- Color de la barra del navegador en móviles: el oscuro de la paleta. -->
    <meta name="theme-color" content="#222222" />
    <!-- Favicon: «TDF» con el marco del logo (letras recortadas del propio logo). favicon.ico lleva 16, 32 y 48 px. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Sin indexar mientras la web no se lance (INDEXABLE en site.config.mjs) y siempre en la página de error. -->
    {(!INDEXABLE || notFound) && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body class="min-h-dvh">
    <IntroLogo />
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-white focus:px-4 focus:py-2">
      {ui[lang].skipLink}
    </a>
    <Header lang={lang} routeKey={routeKey} alternates={alternates} overlay={overlayHeader} />
    <main id="contenido" class={overlayHeader ? '' : 'pt-[4.5rem] min-[1180px]:pt-[5.75rem]'}>
      <slot />
    </main>
    <Footer lang={lang} routeKey={routeKey} alternates={alternates} />
    <QuickContactBar lang={lang} />
    <script>
      import { initFadeCarousel } from '../scripts/fade-carousel';
      import { initParallax } from '../scripts/parallax';
      import { initDraw } from '../scripts/draw';
      import { whenIntroOpen } from '../scripts/intro';
      document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initFadeCarousel);
      initParallax();
      initDraw();

      // Revela los elementos [data-reveal] cuando entran en pantalla (tras abrirse el telón de la presentación).
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-revealed');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        whenIntroOpen(() => items.forEach((el) => io.observe(el)));
      } else {
        items.forEach((el) => el.classList.add('is-revealed'));
      }
    </script>
  </body>
</html>
