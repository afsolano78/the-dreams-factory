---
import WeddingPage from '../../components/weddings/WeddingPage.astro';
import { getWeddings, type Wedding } from '../../content/weddings';

/** Una página por cada boda que ya tiene galería. */
export async function getStaticPaths() {
  return (await getWeddings()).filter((w) => w.page).map((w) => ({ params: { slug: w.slug.es }, props: { wedding: w } }));
}

const { wedding } = Astro.props as { wedding: Wedding };
---

<WeddingPage lang="es" wedding={wedding} />
