---
import PendingPage from '../../components/PendingPage.astro';
import { routes, pendingPages, type RouteKey } from '../../i18n/routes';

export function getStaticPaths() {
  return pendingPages.map((key) => ({
    params: { page: routes[key].en.replace('/en/', '') },
    props: { routeKey: key },
  }));
}

const { routeKey } = Astro.props as { routeKey: RouteKey };
---

<PendingPage lang="en" routeKey={routeKey} />
