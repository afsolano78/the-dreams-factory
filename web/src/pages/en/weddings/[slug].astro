---
import WeddingPage from '../../../components/weddings/WeddingPage.astro';
import { weddings, type Wedding } from '../../../content/weddings';

/** One page per wedding that already has a gallery. */
export function getStaticPaths() {
  return weddings.filter((w) => w.page).map((w) => ({ params: { slug: w.slug.en }, props: { wedding: w } }));
}

const { wedding } = Astro.props as { wedding: Wedding };
---

<WeddingPage lang="en" wedding={wedding} />
