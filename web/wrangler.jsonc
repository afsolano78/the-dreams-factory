// Configuración de Cloudflare Workers.
// Workers Builds ejecuta `npm run build` en esta carpeta (web/) y después `npx wrangler deploy`, que publica
// el contenido de dist/ en el Worker «dreams-factory-prototipo» (el nombre debe coincidir con el del panel).
// El Worker (worker/index.ts) solo atiende /api/* (formulario de contacto); el resto son las páginas de dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreams-factory-prototipo",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Solo el formulario pasa por el Worker; las páginas se sirven directamente.
    "run_worker_first": ["/api/*"],
    // Rutas sin archivo: se muestra la página 404 propia (dist/404.html).
    "not_found_handling": "404-page",
    // /servicios → /servicios/ (las páginas se generan como carpeta/index.html).
    "html_handling": "auto-trailing-slash"
  },
  // Formulario de contacto. Los secretos (RESEND_API_KEY, TURNSTILE_SECRET) van en el panel, no aquí.
  "vars": {
    "CONTACT_TO": "thedreamsfactoryweddingplanner@gmail.com",
    "CONTACT_FROM": "The Dreams Factory <web@thedreamsfactory.es>",
    // "si" para enviar un acuse de recibo a la pareja (requiere el dominio verificado en Resend).
    "AUTOREPLY": "no"
  },
  "observability": { "enabled": true }
}
