// Configuración de Cloudflare Workers.
// Workers Builds ejecuta `npm run build` en esta carpeta (web/) y después `npx wrangler deploy`, que publica
// el contenido de dist/ en el Worker «dreams-factory-prototipo» (el nombre debe coincidir con el del panel).
// El Worker (worker/index.ts) solo atiende /api/* (formulario de contacto e Instagram); el resto son las páginas de dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreams-factory-prototipo",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Solo el formulario pasa por el Worker; las páginas se sirven directamente.
    "run_worker_first": ["/api/*"],
    // Rutas sin archivo: se muestra la página 404 propia (dist/404.html).
    "not_found_handling": "404-page",
    // /servicios → /servicios/ (las páginas se generan como carpeta/index.html).
    "html_handling": "auto-trailing-slash"
  },
  // Formulario de contacto. Los secretos (RESEND_API_KEY, TURNSTILE_SECRET) van en el panel, no aquí.
  "vars": {
    "CONTACT_TO": "thedreamsfactoryweddingplanner@gmail.com",
    "CONTACT_FROM": "The Dreams Factory <web@thedreamsfactory.es>",
    // "si" para enviar un acuse de recibo a la pareja (dominio verificado en Resend el 22-11-2026).
    "AUTOREPLY": "si",
    // Cuenta de Instagram @the_dreamsfactory (no es secreto). El código IG_TOKEN es de usuario del sistema de Meta
    // («EAA…», sin caducidad) y con él la web no puede averiguar esta cuenta sola. Ver INSTAGRAM.md.
    "IG_USER_ID": "17841402337576102"
  },
  // Instagram (worker/instagram.ts): últimas publicaciones una vez al día, a las 5:17 UTC. Ver INSTAGRAM.md.
  "triggers": { "crons": ["17 5 * * *"] },
  // Lista y fotos de Instagram (KV «dreams-instagram»).
  "kv_namespaces": [{ "binding": "INSTAGRAM", "id": "2e9bce879bca4cc887a1dfb3ef2f0db2" }],
  // Reduce las fotos de Instagram a 720 px en WebP (Cloudflare Images; el plan gratuito incluye 5000 transformaciones
  // al mes y aquí se usan unas pocas al día).
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
